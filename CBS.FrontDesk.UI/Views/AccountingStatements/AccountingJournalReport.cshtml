@model CBS.FrontDesk.Data.Entity.Accounting.AccountingEntryQuery
@{
    ViewBag.Title = "Accounting Journal Entries Veriification";
}
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-check me-2"></i>Journal Entries
                </h1>
                <p class="card-text">
                    This view enable the user to retrieve or print journal entry advicer within the period of 1 year from 1st of January to 31st december of the past.
                </p>
                <p class="card-text text-warning fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i>  In case you wish to have data above the period of year please kindly contact system administrator..
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i>  TIPS FOR ACCOUNTING REPORTS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>ENTER THE REFERENCE :</strong>Enter the journal entry accounting reference.</li>

            </ul>
        </div>
    </div>
</div>

<!-- Advanced Filters -->

<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i>@AccountingStatements_Index.ACCOUNTINGREPORT</h5>
    <div class="card p-3 mb-3 bg-light">
        <div class="row mb-3">

            <div class="card-body d-sm-flex d-block">


                @Html.Partial("_SearchJournalEntryData")

            </div>
            <div id="datalistingview">
            
            </div>

        </div>
    </div>
</div>
@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/main.js/GetJournalEntryByReference.js"></script>
}

