@model List<CBS.FrontDesk.Data.Entity.Accounting.AccountingEntryDto>
<div class="table-responsive mb-3">
    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>Date</th>
                <th>AccountNumber</th>
                <th>AccountName</th>
                <th>Debit</th>
                <th>Credit</th>
                <th>Balance</th>
                
                <th>Reference</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td style="width:20%">@d.EntryDate</td>
                    <td style="width:15%">@d.AccountNumber</td>
                    <td style="width:25%">@d.AccountHolder</td>
                    <td style="width:10%">@d.DebitAmount</td>
                    <td style="width:10%">@d.CreditAmount</td>
                    <td style="width:10%">@d.CrCurrentBalance</td>
                    <td style="width:10%">@d.TransactionReference</td>
                </tr>
            }
        </tbody>
    </table>
</div>
