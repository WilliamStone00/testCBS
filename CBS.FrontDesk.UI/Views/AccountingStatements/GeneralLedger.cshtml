@model  CBS.FrontDesk.Data.Entity.Accounting.AccountingStatementDto
@using Resources
@if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
{
    <div class="row">

        <div class="col-xl-12 col-lg-12 col-md-12 order-12 order-md-12">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-file-document-outline me-2"></i>
                            @GeneralLedger.GENERALLEDGERPERBRANCH
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">

                                    <div class="table-responsive mb-3">
                                        <table class="table table-hover" id="BranchDataTable">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>@GeneralLedger.Code</th>
                                                    <th>@GeneralLedger.BranchName</th>
                                                    <th>@GeneralLedger.Location</th>
                                                    <th>@GeneralLedger.Action</th>

                                                </tr>
                                            </thead>
                                            <tbody>

                                                @foreach (var d in Model.Branches)
                                                {
                                                    <tr>
                                                        <td style="width:10%" id="@d.Id-BranchCode">@d.BranchCode</td>
                                                        <td style="width:50%" id="@d.Id-Name">@d.Name</td>
                                                        <td style="width:25%" id="@d.Id-Location">@d.Location</td>
                                                        <td style="width:15%">
                                                            <a href="#" onclick="loadBranchGeneralLedgerByBranchId(@d.Id)" class="mr-2 btn btn-primary waves-effect waves-light" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#exLargeModal" title="@GlobalShared.Select @d.Name @GeneralLedger.ToViewGeneralLedger">@GlobalShared.View</a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    @Html.Partial("_GeneralLedgerData")
                                </div>
                            </div>
                        </div>



                    </div>
                </div>

            </div>

        </div>

    </div>

}
else
{
    <div class="row">

        <div class="col-xl-12 col-lg-12 col-md-12 order-12 order-md-12">
            <div class="col-xl-12 col-lg-12 col-md-12 order-12 order-md-12">
                <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">



                    <div class="accordion-item active">
                        <h2 class="accordion-header text-body d-flex justify-content-between"
                            id="accordionPopoutIconThree">
                            <button type="button"
                                    class="accordion-button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#accordionPopoutIcon-3"
                                    aria-expanded="true"
                                    aria-controls="accordionPopoutIcon-3">
                                <i class="mdi mdi-file-document-outline me-2"></i>
                                @GeneralLedger.GENERALLEDGERFOR  @Session["BranchName"]
                            </button>
                        </h2>



                        <div id="accordionPopoutIcon-3"
                             class="accordion-collapse collapse show"
                             data-bs-parent="#accordionPopoutIcon">
                            <div class="accordion-body">
                                <div id="mainviewChange">
                                    <div class="change-group">

                                        <div id="accordionPopoutIcon_3" class="accordion mt-3 accordion-popout">

                                            <div class="accordion-item">
                                                <h2 class="accordion-header text-body d-flex justify-content-between"
                                                    id="accordionPopoutIconThree">
                                                    <button type="button"
                                                            class="accordion-button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#accordionPopoutIcon-3"
                                                            aria-expanded="true"
                                                            aria-controls="accordionPopoutIcon-3">
                                                        <i class="mdi mdi-table-alert me-2"></i>
                                                        @GeneralLedger.ClassicView
                                                    </button>
                                                </h2>



                                                <div id="accordionPopoutIcon-classic"
                                                     class="accordion-collapse collapse show"
                                                     data-bs-parent="#accordionPopoutIcon">
                                                    <div class="accordion-body">
                                                        <div id="mainviewChange">
                                                            <div class="change-group">

                                                                <div class="table-responsive mb-3">
                                                                    <table class="table table-hover" id="AccountDataTable">
                                                                        <thead class="table-light">
                                                                            <tr>
                                                                                <th>@GeneralLedger.AccountNumber</th>
                                                                                <th>@GeneralLedger.Description</th>
                                                                                <th>@GeneralLedger.CurrentBalance</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>

                                                                            @foreach (var d in Model.Accounts)
                                                                            {
                                                                                <tr>
                                                                                    <td style="width:25%">@d.AccountNumber</td>
                                                                                    <td style="width:50%">@d.AccountName</td>
                                                                                    <td style="width:25%">@d.CurrentBalance</td>

                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                                <div class="card-header shift-right">



                                                                    <div class="col-lg-3 col-sm-6 col-12">

                                                                        <div class="demo-inline-spacing">
                                                                            <div class="btn-group" id="dropdown-icon-demo">
                                                                                <button type="button"
                                                                                        class="btn btn-primary dropdown-toggle"
                                                                                        data-bs-toggle="dropdown"
                                                                                        aria-expanded="false">
                                                                                    <i class="mdi mdi-cloud-download-outline me-1"></i>  @GeneralLedger.DownloadGeneralLedger
                                                                                </button>
                                                                                <ul class="dropdown-menu">
                                                                                    <li>
                                                                                        <a href="javascript:void(0);" onclick="DownLoadGL('EXCEL')" class="dropdown-item d-flex align-items-center"><i class="mdi mdi-chevron-right scaleX-n1-rtl"></i>@GeneralLedger.InExcelFormat</a>
                                                                                    </li>
                                                                                    <li>
                                                                                        <a href="javascript:void(0);" onclick="DownLoadGL('PDF')" class="dropdown-item d-flex align-items-center"><i class="mdi mdi-chevron-right scaleX-n1-rtl"></i>@GeneralLedger.InPDFFormat</a>
                                                                                    </li>
                                                                                </ul>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>



                                                </div>
                                            </div>

                                        </div>



                                    </div>
                                </div>
                            </div>



                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
}


@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/main.js/AccountingStatements.js"></script>
}