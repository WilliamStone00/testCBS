
<div class="modal fade" id="exLargeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title text-center" id="LiaisonLedgerHeading" style="text-align: center;"> Loading ...</h4>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>

            </div>
            <div class="modal-body">

               
                <div class="table-responsive mb-3">
                                    <table class="table table-hover" id="LiaisonLadgerDataTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th>AccountNumber</th>
                                                <th>Description</th>
                                                <th>Debit Balance</th>
                                                <th>Credit Balance</th>
                                                <th>Current Balance</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var d in Model.Accounts)
                                            {
                                                <tr>
                                                    <td style="width:25%">@d.AccountNumber</td>
                                                    <td style="width:25%">@d.AccountName</td>
                                                    <td style="width:25%">@d.DebitBalance</td>
                                                    <td style="width:25%">@d.CreditBalance</td>
                                                    <td style="width:25%">@d.CurrentBalance</td>
                                                     
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                    
                <div class="card-header shift-right">
                    <div class="col-lg-3 col-sm-6 col-12">
                        <input type="hidden" id="selectedBranchId" value="" />
                        <input type="hidden" id="selectedBranchName" value="" />
                        <div class="demo-inline-spacing">
                            <div class="btn-group" id="dropdown-icon-demo">
                                <button type="button"
                                        class="btn btn-primary dropdown-toggle"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="mdi mdi-cloud-download-outline me-1"></i>  Download Liaison Ledger
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a href="javascript:void(0);" onclick="DownLoadLL('EXCEL')" class="dropdown-item d-flex align-items-center"><i class="mdi mdi-chevron-right scaleX-n1-rtl"></i>In Excel Format</a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0);" onclick="DownLoadLL('PDF')" class="dropdown-item d-flex align-items-center"><i class="mdi mdi-chevron-right scaleX-n1-rtl"></i>In PDF Format</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Close
                    </button>
                </div>


            </div>
        </div>
    </div>
</div>