@model CBS.FrontDesk.Data.Entity.Accounting.AccountingEntryQuery
    @using Resources
<div class="container">
    @*<fieldset class="fieldset">*@
    <div class="card-body">
        @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostSearch(this);" }))
        {
            <div class="row justify-content-center mt-2 gy-4">
                @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                {
                    <div class="col-6 mb-sm-1">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(model => model.SystemQuery.BranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Text", "Value"), "---Select Branch---", new { @class = "form-control select2", @search = "true" })
                            @Html.ValidationMessageFor(model => model.SystemQuery.BranchId, "", new { @class = "text-danger" })
                            <label>Branch Office</label>
                        </div>
                    </div>
                    <div class="col-md-6 mb-sm-1">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(model => model.SystemQuery.ReportType, new SelectList(ViewBag.ReportTypes == null ? "" : ViewBag.ReportTypes, "Text", "Value"), "---Select ReportTypes---", new { @class = "form-control select2", @search = "true", @id = "SystemQuery_ReportType" })
                            @Html.ValidationMessageFor(model => model.SystemQuery.ReportType, "", new { @class = "text-danger" })
                            <label>Select ReportType</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <div id="AccountToHide">
                            <div class="form-floating form-floating-outline">

                                @Html.ListBoxFor(model => model.SystemQuery.AccountIds, new SelectList(ViewBag.Accounts == null ? new List<SelectListItem>() : ViewBag.Accounts, "Text", "Value"), new { @class = "form-control select2", @multiple = "multiple", @id = "SystemQuery_AccountId" })
                                @Html.ValidationMessageFor(model => model.SystemQuery.AccountIds, "", new { @class = "text-danger" })
                                <label>Select Account</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(model => model.SystemQuery.FromDate, new
                             {
                                 @class = "form-control",
                                 type = "datetime-local",
                                 id = "fromDate"
                             })
                            @Html.ValidationMessageFor(model => model.SystemQuery.FromDate, "", new { @class = "text-danger" })
                            <label>From Date</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">



                            @Html.TextBoxFor(model => model.SystemQuery.ToDate, new
{
 @class = "form-control",
 type = "datetime-local",
 id = "toDate"
})
                            @Html.ValidationMessageFor(model => model.SystemQuery.ToDate, "", new { @class = "text-danger" })

                            <label>To Date</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(model => model.SystemQuery.FileType, new SelectList(ViewBag.FileTypes == null ? "" : ViewBag.FileTypes, "Text", "Value"), "---Select FileTypes---", new { @class = "form-control select2", @search = "true" })
                            @Html.ValidationMessageFor(model => model.SystemQuery.FileType, "", new { @class = "text-danger" })
                            <label>Select FileType</label>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <input type="checkbox" class="form-check-input" id="ActivateAuditId" value="false" />
                        <label for="IsHarmonizationActivated">UnCheck if you which to aggregate two or more branch financial statement</label>
                    </div>
                    <div class="col-12">
                        <div id="ListOfBranchToHide">
                            <div class="form-floating form-floating-outline">

                                @Html.ListBoxFor(model => model.SystemQuery.BranchIds, new SelectList(ViewBag.Branches == null ? new List<SelectListItem>() : ViewBag.Branches, "Text", "Value"), new { @class = "form-control select2", @multiple = "multiple", @id = "SystemQuery_BranchIds" })
                                @Html.ValidationMessageFor(model => model.SystemQuery.BranchIds, "", new { @class = "text-danger" })
                                <label>Select Branch</label>
                            </div>
                        </div>
                    </div>
     
                    <div class="col-md-12 mb-sm-1">
                        <div id="ZeroAccount">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(model => model.SystemQuery.ReferenceId, new SelectList(ViewBag.ZeroStatus == null ? "" : ViewBag.ZeroStatus, "Value", "Text"), "---Select  ZeroStatus---", new { @class = "form-control select2", @search = "true", @id = "SystemQuery_ReferenceId" })
                                @Html.ValidationMessageFor(model => model.SystemQuery.ReferenceId, "", new { @class = "text-danger" })
                                <label>Select Zeros Account</label>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    //
                    <div class="col-md-6 mb-sm-1">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(model => model.SystemQuery.ReportType, new SelectList(ViewBag.ReportTypes == null ? "" : ViewBag.ReportTypes, "Text", "Value"), "---Select ReportTypes---", new { @class = "form-control select2", @search = "true", @id = "SystemQuery_ReportType" })
                            @Html.ValidationMessageFor(model => model.SystemQuery.ReportType, "", new { @class = "text-danger" })
                            <label>Select ReportType</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(model => model.SystemQuery.FileType, new SelectList(ViewBag.FileTypes == null ? "" : ViewBag.FileTypes, "Text", "Value"), "---Select FileTypes---", new { @class = "form-control select2", @search = "true" })
                            @Html.ValidationMessageFor(model => model.SystemQuery.FileType, "", new { @class = "text-danger" })
                            <label>Select FileType</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <div id="AccountToHide">
                            <div class="form-floating form-floating-outline">

                                @Html.ListBoxFor(model => model.SystemQuery.AccountIds, new SelectList(ViewBag.Accounts == null ? new List<SelectListItem>() : ViewBag.Accounts, "Text", "Value"), new { @class = "form-control select2", @multiple = "multiple", @id = "SystemQuery_AccountId" })
                                @Html.ValidationMessageFor(model => model.SystemQuery.AccountIds, "", new { @class = "text-danger" })
                                <label>Select Account</label>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(model => model.SystemQuery.FromDate, new
                             {
                                 @class = "form-control",
                                 type = "datetime-local",
                                 id = "fromDate"
                             })   @*@Html.TextBoxFor(model => model.SystemQuery.FromDate, new { @class = "form-control", @id = "dateFrom", @autocomplete = "off" })*@
                            @Html.ValidationMessageFor(model => model.SystemQuery.FromDate, "", new { @class = "text-danger" })
                            <label>From Date</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">



                            @Html.TextBoxFor(model => model.SystemQuery.ToDate, new
{
 @class = "form-control",
 type = "datetime-local",
 id = "toDate"
})
                            @Html.ValidationMessageFor(model => model.SystemQuery.ToDate, "", new { @class = "text-danger" })

                            <label>To Date</label>
                        </div>
                    </div>
                    <div id="ZeroAccount">
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(model => model.SystemQuery.ReferenceId, new SelectList(ViewBag.ZeroStatus == null ? "" : ViewBag.ZeroStatus, "Value", "Text"), "---Select  ZeroStatus---", new { @class = "form-control select2", @search = "true", @id = "SystemQuery_ReferenceId" })
                                @Html.ValidationMessageFor(model => model.SystemQuery.ReferenceId, "", new { @class = "text-danger" })
                                <label>Select Zeros Account</label>
                            </div>
                        </div>
                    </div>

                }
                <input type="hidden" id="selectedBranchID" value="" />
            </div>
            <br>
            <div class="col-md-12 d-flex justify-content-between align-items-center">

                <!-- Left-aligned button -->
                <div id="lunchBalanceSheetBuilder">

                    <button type="button" class="btn btn-primary mdi mdi-play-box mdi-24px" data-bs-toggle="modal" data-bs-target="#fullscreenModal" onclick="launchBalanceSheetBuilder()">
                        Lunch Balance Sheet Builder
                    </button>
                </div>

                <!-- Right-aligned button -->
                <button type="submit" class="btn btn-primary mdi mdi-printer-pos-alert mdi-24px me-2">Print</button>







            </div>
            @*</fieldset>*@
        }
    </div>
</div>









